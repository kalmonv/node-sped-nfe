{
  "name": "node-sped-nfe",
  "version": "1.2.52",
  "author": "Kalmon V. Tavares",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nota fiscal",
    "xml",
    "sefaz",
    "nfe",
    "sped",
    "documento fiscal",
    "danfe",
    "nfce",
    "pdf"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json > saida.txt",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/cjs',{recursive:true});fs.writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n');\"",
    "t:status": "node exemplos/status.js",
    "t:nfe": "node exemplos/nfe.js",
    "t:nfce": "node exemplos/nfce.js",
    "t:cons": "node exemplos/consulta.js",
    "teste": "tsx testes/teste.js"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.11",
    "@types/pem": "^1.14.4",
    "@types/tmp": "^0.2.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "fast-xml-parser": "^4.5.1",
    "pem": "^1.14.8",
    "tmp": "^0.2.3",
    "xml-crypto": "^6.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kalmonv/node-sped-nfe.git"
  },
  "license": "MIT"
}
